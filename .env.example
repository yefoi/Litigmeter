# Clave de TypeSafe AI (https://console.typesafe.ai) para clasificar con jev.
# Sin ella, la ingesta guarda los datos sin clasificar.
TYPESAFE_AI_API_KEY=

# Umbral de P(true) para marcar una CCAA como noticiable (por defecto 0.75).
# Ajústalo con `npm run calibrar` y vuelve a clasificar con --reclasificar.
UMBRAL_NOTICIABLE=0.75
